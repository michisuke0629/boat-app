# Supabase Project Settings > API Keys から取得（Project URL / API URL）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key（旧: anon key）。RLS配下の公開読取用
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret keys（旧: service_role key）。RLSをバイパスする。絶対にNEXT_PUBLIC_を付けずクライアントに露出させないこと
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# cron routeの認証用。ランダムな文字列を自分で生成する（例: openssl rand -hex 32）
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
